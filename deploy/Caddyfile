# /etc/caddy/Caddyfile
# Auto-HTTPS reverse proxy for fastify-api.ayushpaharia.in -> Fastify on :4000

{
	email ayush.paharia.18@gmail.com
}

fastify-api.ayushpaharia.in {
	encode zstd gzip

	# Caddy's reverse_proxy auto-forwards X-Forwarded-For / -Proto.
	# Fastify trusts them (trustProxy: true) so req.ip is the real client.
	reverse_proxy 127.0.0.1:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	# Note: edge rate-limiting requires the caddy-ratelimit plugin (not in core).
	# Fastify app-level limits (15/min reads, 5/min writes, 2/min ingest, ban on 3 strikes)
	# are sufficient defense for a single-VM deploy.

	# Logs go to journald via stdout — view with: journalctl -u caddy -f
	log {
		format json
	}
}
